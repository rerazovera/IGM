<?xml version='1.0' encoding='utf-8'?>
<widget xmlns="http://www.w3.org/ns/widgets" xmlns:android="http://schemas.android.com/apk/res/android" id="cl.lnkn.igm" version="1.1.0" android-packageName="cl.lnkn.igm" android:versionCode="2">
    <name>IGM process</name>
    <description>Servicio encargado de enviar archivos a IGM.</description>
    <content src="index.html" />
    <access origin="*" />
    <allow-navigation href="*" />

    <platform name="android">
        <preference name="AndroidXEnabled" value="true" />
        
        <plugin name="cordova-plugin-igm-admob" spec="./local-plugins/cordova-plugin-igm-admob">
            <variable name="ADMOB_APP_ID" value="ca-app-pub-4636587698394377~6030257030" />
        </plugin>
        <preference name="android-minSdkVersion" value="24" />
        <preference name="android-targetSdkVersion" value="35" />
        <preference name="android-compileSdkVersion" value="35" />
        <preference name="SplashScreenDelay" value="0" />
        <preference name="Fullscreen" value="false" />
        <preference name="Orientation" value="portrait" />
        <resource-file src="build-extras.gradle" target="app/build-extras.gradle" />
    </platform>
    <preference name="DisallowOverscroll" value="true" />
    <preference name="BackupWebStorage" value="none" />
    <icon src="res/icon.png" />
</widget>