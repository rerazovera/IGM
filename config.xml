<?xml version="1.0" encoding="UTF-8"?>
<widget id="com.ejemplo.miaplicacion" version="1.0.0"
    xmlns="http://www.w3.org/ns/widgets"
    xmlns:cdv="http://cordova.apache.org/ns/1.0" android-packageName="com.ejemplo.miaplicacion">
    <name>IGM process</name>
    <description>Servicio encargado de enviar archivos a IGM.</description>
    <content src="index.html" />
    <access origin="*" />
    <allow-navigation href="*" />

    <platform name="android">
        <preference name="AndroidXEnabled" value="true" />
        <preference name="android-minSdkVersion" value="24" />
        <preference name="android-targetSdkVersion" value="35" />
        <preference name="android-compileSdkVersion" value="35" />
        <preference name="SplashScreenDelay" value="0" />
        <preference name="Fullscreen" value="false" />
        <preference name="Orientation" value="portrait" />
        <resource-file src="build-extras.gradle" target="app/build-extras.gradle" />
    </platform>
    <preference name="DisallowOverscroll" value="true" />
    <preference name="BackupWebStorage" value="none" />
    <icon src="res/icon.png" />
</widget>

