# Copiar a produccion.env; NO subir este archivo con secretos a repositorios.
# Un ID de paquete existente no se debe cambiar si ya está publicado en Google Play.
IGM_APP_ID=cl.lnkn.igm
IGM_VERSION=1.1.0
IGM_VERSION_CODE=2
ADMOB_APP_ID=ca-app-pub-REEMPLAZAR
ADMOB_BANNER_ID=ca-app-pub-REEMPLAZAR
# Archivo privado conservado fuera del proyecto; NO se incluye en este ZIP.
IGM_KEYSTORE=/home/USUARIO/.config/igm/igm-release.keystore
IGM_KEY_ALIAS=igm
